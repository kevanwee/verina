# Copy to .env for local development. Never commit real secrets.
VERINA_ENV=local
VERINA_LOG_LEVEL=INFO
# Comma-separated JSON list of allowed browser origins for CORS (not yet enabled).
VERINA_ALLOWED_ORIGINS=["http://localhost:3000"]
# SQLAlchemy URL (ADR 004). SQLite locally (.data/ is git-ignored); CI uses
# postgresql+psycopg://user:pass@host:5432/db. Apply migrations: python -m alembic upgrade head
VERINA_DATABASE_URL=sqlite:///./.data/verina-local.db
# Optional audit chain-head HMAC key, at least 32 bytes. Generate locally; never commit.
# VERINA_AUDIT_HEAD_KEY=
# Authenticated /v1 matter API (ADR 007). Off by default (health-only). When true,
# VERINA_ENV must be explicitly set to local or test, and the issuer, audience and a static
# public JWKS are all required, or startup fails.
# VERINA_MATTERS_API_ENABLED=false
# VERINA_AUTH_ISSUER=https://idp.example.test/
# API identifier, never an OAuth client_id.
# VERINA_AUTH_AUDIENCE=verina-api
# JSON list of extra audiences a multi-audience token may also carry (default: none).
# VERINA_AUTH_EXTRA_AUDIENCES=[]
# Inline JWKS JSON or a local file path (public keys only; RS256/ES256/EdDSA with kid + alg).
# Mutually exclusive with VERINA_AUTH_JWKS_URL (below).
# VERINA_AUTH_JWKS=./.data/jwks.json
# VERINA_AUTH_LEEWAY_SECONDS=30
# VERINA_AUTH_MAX_TOKEN_LIFETIME_SECONDS=3600

# --- Supabase development project (ADR 009) ------------------------------------------
# Copy this block to apps/api/.env (git-ignored) and fill in the two secrets. Values below
# marked "public" are safe to commit; secrets are placeholders only.
# VERINA_ENV=development requires: issuer, audience, JWKS URL, audit head key and an
# explicit database URL. Staging and production are refused.
# VERINA_ENV=development
# VERINA_MATTERS_API_ENABLED=true
# public:
# VERINA_AUTH_PROFILE=supabase
# VERINA_AUTH_ISSUER=https://scsphlyjfxzluovvfese.supabase.co/auth/v1
# VERINA_AUTH_AUDIENCE=authenticated
# VERINA_AUTH_JWKS_URL=https://scsphlyjfxzluovvfese.supabase.co/auth/v1/.well-known/jwks.json
# VERINA_SUPABASE_URL=https://scsphlyjfxzluovvfese.supabase.co
# VERINA_AUTH_INVITE_REDIRECT_URL=http://localhost:3000/auth/callback
# Require MFA (aal2) for platform-admin actions. Default false for development; set true
# before any non-development use.
# VERINA_AUTH_ADMIN_REQUIRE_AAL2=false
# VERINA_AUTH_REQUIRE_AAL2=false
# secret (session pooler, IPv4; always sslmode=require; percent-encode the password):
# VERINA_DATABASE_URL=postgresql+psycopg://postgres.scsphlyjfxzluovvfese:<DB-PASSWORD>@<POOLER-HOST>:5432/postgres?sslmode=require
# secret (Supabase secret key, sb_secret_...; server-side only, never in the web app):
# VERINA_SUPABASE_SECRET_KEY=<SUPABASE-SECRET-KEY>
# secret (>= 32 random bytes, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"):
# VERINA_AUDIT_HEAD_KEY=<RANDOM-48-BYTE-STRING>
# Optional JWKS cache tuning (defaults shown):
# VERINA_AUTH_JWKS_CACHE_TTL_SECONDS=600
# VERINA_AUTH_JWKS_REFETCH_INTERVAL_SECONDS=30
# VERINA_AUTH_JWKS_MAX_STALE_SECONDS=21600
# VERINA_AUTH_JWKS_TIMEOUT_SECONDS=5
