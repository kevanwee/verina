# Copy to .env for local development. Never commit real secrets.
VERINA_ENV=local
VERINA_LOG_LEVEL=INFO
# Comma-separated JSON list of allowed browser origins for CORS (not yet enabled).
VERINA_ALLOWED_ORIGINS=["http://localhost:3000"]
# SQLAlchemy URL (ADR 004). SQLite locally (.data/ is git-ignored); CI uses
# postgresql+psycopg://user:pass@host:5432/db. Apply migrations: python -m alembic upgrade head
VERINA_DATABASE_URL=sqlite:///./.data/verina-local.db
# Optional audit chain-head HMAC key, at least 32 bytes. Generate locally; never commit.
# VERINA_AUDIT_HEAD_KEY=
# Authenticated /v1 matter API (ADR 007). Off by default (health-only). When true,
# VERINA_ENV must be explicitly set to local or test, and the issuer, audience and a static
# public JWKS are all required, or startup fails.
# VERINA_MATTERS_API_ENABLED=false
# VERINA_AUTH_ISSUER=https://idp.example.test/
# API identifier, never an OAuth client_id.
# VERINA_AUTH_AUDIENCE=verina-api
# JSON list of extra audiences a multi-audience token may also carry (default: none).
# VERINA_AUTH_EXTRA_AUDIENCES=[]
# Inline JWKS JSON or a local file path (public keys only; RS256/ES256/EdDSA with kid + alg).
# VERINA_AUTH_JWKS=./.data/jwks.json
# VERINA_AUTH_LEEWAY_SECONDS=30
# VERINA_AUTH_MAX_TOKEN_LIFETIME_SECONDS=3600
