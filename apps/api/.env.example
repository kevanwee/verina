# Copy to .env for local development. Never commit real secrets.
VERINA_ENV=local
VERINA_LOG_LEVEL=INFO
# Comma-separated JSON list of allowed browser origins for CORS (not yet enabled).
VERINA_ALLOWED_ORIGINS=["http://localhost:3000"]
# SQLAlchemy URL (ADR 004). SQLite locally (.data/ is git-ignored); CI uses
# postgresql+psycopg://user:pass@host:5432/db. Apply migrations: python -m alembic upgrade head
VERINA_DATABASE_URL=sqlite:///./.data/verina-local.db
# Optional audit chain-head HMAC key, at least 32 bytes. Generate locally; never commit.
# VERINA_AUDIT_HEAD_KEY=
