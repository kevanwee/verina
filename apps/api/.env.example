# Copy to .env for local development. Never commit real secrets.
VERINA_ENV=local
VERINA_LOG_LEVEL=INFO
# Comma-separated JSON list of allowed browser origins for CORS (not yet enabled).
VERINA_ALLOWED_ORIGINS=["http://localhost:3000"]
# Target store is Postgres + pgvector; unit tests use SQLite.
VERINA_DATABASE_URL=sqlite:///./verina-local.db
