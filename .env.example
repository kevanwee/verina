# Copy to apps/web/.env.local and fill locally. Connected mode is off by default.
VERINA_CONNECTED=0
VERINA_PUBLIC_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VERINA_API_BASE_URL=http://127.0.0.1:8000
# Use a publishable/anon key only; never a secret/service-role key.
